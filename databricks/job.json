{
  "name": "dch-notify-github",
  "git_source": {
    "git_url": "https://github.com/jeevss131436/cummins-cicd-dummy",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "tasks": [
    {
      "task_key": "notify_github",
      "notebook_task": {
        "notebook_path": "databricks/notify_github",
        "source": "GIT"
      },
      "timeout_seconds": 300
    }
  ],
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "/Volumes/<catalog>/dch_demo/landing/"
    }
  },
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  }
}
